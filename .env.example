#  Video Template SaaS - the only values you MUST fill in are

#  VILAO_BASE_URL and VILAO_API_KEY (run.py creates .env

#  for you and generates SECRET_KEY / ADMIN_PASSWORD).

# ============================================================



# --- Vilao.ai gateway: ONE main key reaches all models (models are managed in the admin UI) ---

VILAO_BASE_URL=https://api.vilao.ai/v1

VILAO_API_KEY=

VILAO_IMAGE_SIZE=1024x1024



# --- MiniMax-H3 video generation (separate key from the Vilao gateway) ---

MINIMAX_API_KEY=

MINIMAX_BASE_URL=https://api.xah.io

MINIMAX_MODEL=MiniMax-H3

# Endpoint paths; xah.io v2 public gateway: POST {base}/v2/video_generation, query /v2/query/video_generation/{task_id}

# if the query path differs for your account run: python scripts/check_minimax.py

MINIMAX_CREATE_PATH=/v2/video_generation

MINIMAX_QUERY_PATH=/v2/query/video_generation/{task_id}

MINIMAX_POLL_SECONDS=3

MINIMAX_MAX_WAIT_SECONDS=1200

# Extra JSON merged into the create request, e.g. {"generate_audio": true}

MINIMAX_EXTRA_PARAMS=



# --- Core (run.py generates these on first start) ---

# APP_ENV=production when publishing to the Internet: the app will refuse to start with unsafe valuesg n-u

# SECRET_KEY >= 32 random chars and a real ADMIN_PASSWORD are required in production".

APP_ENV=dev

SECRET_KEY=

ADMIN_USERNAME=admin

ADMIN_EMAIL=admin@example.com

ADMIN_PASSWORD=

DATABASE_URL=sqlite:///./storage/app.db

STORAGE_DIR=./storage

# Timeout & queue limits (seconds)

SWEEP_INTERVAL_SECONDS=30

FAST_TIMEOUT_SECONDS=600

HEAVY_TIMEOUT_SECONDS=5400

HEAVY_QUEUE_TIMEOUT_SECONDS=21600

AI_TIMEOUT_SECONDS=1800

AI_QUEUE_TIMEOUT_SECONDS=3600

# Max video size in MB when downloading from social media (over the limit -> "not supported")

DOWNLOAD_MAX_MB=200

# VAD=1: cut audio at silence so long speeches do not become one huge caption

WHISPER_MODEL=

WHISPER_VAD=1

# Abuse limits

LOGIN_MAX_FAILURES=8

REGISTER_PER_HOUR=20

# Hugging Face API (Whisper & Translation)

HUGGINGFACE_API_KEY=



# --- ElevenLabs voice clone: upload a voice sample -> clone for real -> use it for TTS (needsa edge-tts thay th-

# the key below; without it voice-upload only stores the sample and uses edge-tts instead)one ---c; pipeline d-ng edge-tts b-nh th--ng.

ELEVENLABS_API_KEY=



# --- Initial prices only: after the first start the admin sets real prices in the "Bang gia" tab is the source of truth ---

FAST_RENDER_COST=1

HEAVY_RENDER_COST=10



# --- VietQR (account shown on the QR) + webhook secrets from SePay / Casso ---

BANK_BIN=vcb

BANK_ACCOUNT_NO=0000000000

BANK_ACCOUNT_NAME=NGUYEN VAN A

SEPAY_API_KEY=

CASSO_SECURE_TOKEN=

TX_TTL_SECONDS=300

LATE_PAYMENT_AUTOCREDIT=0



# --- Heavy render: MimicMotion + Celery/Redis (optional, needs an NVIDIA GPU) ---

REDIS_URL=redis://localhost:6379/0

CELERY_ALWAYS_EAGER=0

MIMICMOTION_DIR=./vendor/MimicMotion

MIMICMOTION_PYTHON=python3

MIMICMOTION_BASE_MODEL=stabilityai/stable-video-diffusion-img2vid-xt-1-1

MIMICMOTION_CKPT=models/MimicMotion_1-1.pth

MIMICMOTION_NUM_FRAMES=72



# --- API keys of the models the admin adds in the UI (Quan ly Model) ---

# The app writes/removes these lines when the admin adds/edits/deletes a model (raw keys are NOT l-u v-o DB).

# stored in the DB). Example: model id 'veo-3' -> MODEL_VEO_3_API_KEY=...

#        model id 'deepseek-llm' -> MODEL_DEEPSEEK_LLM_API_KEY=...

# MODEL_EXAMPLE_MODEL_API_KEY=


# --- Support links (Zalo/Facebook/Telegram) + in-app AI chat ---
SITE_NAME=StudioAI
SUPPORT_ZALO_URL=https://zalo.me/<your_phone_number>
SUPPORT_FACEBOOK_URL=https://www.facebook.com/<your_facebook_page>
SUPPORT_TELEGRAM_URL=https://t.me/<your_telegram_channel>
SUPPORT_EMAIL=support@studioai.id.vn
# 0 = support chat is free; >0 = charge N credits per message (cheapest is 0)- -- 0)
CHAT_CREDIT_COST=0

# --- D-ch & Ph- --: r-ng = t- ch-n theo "-- ch-nh x-c" trong UI (accurate=medium) ---
# WHISPER_MODEL=|medium|large-v3
WHISPER_MODEL=

# --- Phone verification by SMS at registration (ESMS.vn) ---
# REQUIRE_PHONE_VERIFICATION: 0 = tắt (đăng ký không cần SĐT/OTP) | 1 = bắt buộc SĐT + OTP.
# Hiện đang tắt tạm thời (2026-11-11). Bật lại cần tài khoản ESMS.vn + 2 key bên dưới.
REQUIRE_PHONE_VERIFICATION=0
# Register an ESMS account at https://esms.vn and fill in the 2 keys below. Not configured:nh:
#   - APP_ENV=production  -> registration returns 503 (never a fake verification)n)
#   - APP_ENV!=production -> auto-verified so dev/test works without SMS
ESMS_API_KEY=
ESMS_API_SECRET=
ESMS_BRANDNAME=STUDIOAI
ESMS_CONTENT=Ma xac minh dang ky StudioAI la {code}
