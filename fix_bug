### Fix 3 — minimax.py: Thêm subject_reference vào build_payload()

  Trong build_payload() (line 103):
  TRƯỚC:
    def build_payload(prompt, duration, ratio, resolution,
                      first_frame=None, model=None):

  SAU:
    def build_payload(prompt, duration, ratio, resolution,
                      first_frame=None, subject_reference=None, model=None):
        content = [{"type": "text", "text": prompt}]
        if first_frame is not None:
            # ... code hiện có ...
            content.append({..., "role": "first_frame"})
        if subject_reference is not None:
            raw = subject_reference.read_bytes()
            mime = mimetypes.guess_type(subject_reference.name)[0] or "image/png"
            raw, mime = _ensure_min_size(raw, mime)
            b64 = base64.b64encode(raw).decode()
            content.append({
                "type": "image_url",
                "image_url": {"url": f"data:{mime};base64,{b64}"},
                "role": "subject_reference"
            })

